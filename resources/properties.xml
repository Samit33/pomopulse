<?xml version="1.0" encoding="utf-8"?>
<properties>
    <property id="timerMode" type="number">0</property>
    <!-- Durations stored in minutes to match settings.xml ranges;
         legacy installs stored seconds and are migrated on load -->
    <property id="workDuration" type="number">25</property>
    <property id="shortBreakDuration" type="number">5</property>
    <property id="longBreakDuration" type="number">15</property>
    <!-- Daily deep-work goal in minutes -->
    <property id="deepGoal" type="number">120</property>
    <!-- Live depth-zone indicator during focus: 1 = on, 0 = off -->
    <property id="liveFlow" type="number">1</property>
    <!-- Save completed sessions as a FIT activity (syncs to Garmin Connect / Strava) -->
    <property id="syncToGarmin" type="boolean">true</property>
</properties>
